FLASK_DEBUG=1
SECRET_KEY=change-me-32-bytes-minimum-secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# Direct Postgres connection (migrations, seed_admin)
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# Comma-separated allowed CORS origins
FE_ORIGINS=http://localhost:8080,http://localhost:5500

# Webhook delivery (event outbox worker starts only when WEBHOOK_URL is set)
WEBHOOK_URL=
WEBHOOK_SECRET=change-me-webhook-secret
